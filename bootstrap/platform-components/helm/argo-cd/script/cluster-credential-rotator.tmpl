#!/bin/sh

set -u
umask 077

TARGET_SECRET_NAME="${KUBARA_TARGET_SECRET_NAME:-}"
RELEASE_NAMESPACE={{ .Release.Namespace | quote }}
LABEL_KEY={{ .Values.clusterCredentialRotator.secret.labelKey | quote }}
LABEL_VALUE={{ .Values.clusterCredentialRotator.secret.labelValue | quote }}
REQUIRED_TYPE={{ .Values.clusterCredentialRotator.secret.requiredType | quote }}
BOOTSTRAP_KUBECONFIG_KEY={{ .Values.clusterCredentialRotator.secret.bootstrapKubeconfigKey | quote }}
GENERATED_CONFIG_KEY={{ .Values.clusterCredentialRotator.secret.generatedConfigKey | quote }}
CONFIG_MAP_SUFFIX={{ default "-config" .Values.clusterCredentialRotator.secret.configMapSuffix | quote }}
AGENT_NAMESPACE_ANNOTATION={{ default "kubara.io/agent-namespace" .Values.clusterCredentialRotator.agent.namespaceAnnotation | quote }}
DEFAULT_AGENT_NAMESPACE={{ default "kubara" .Values.clusterCredentialRotator.agent.defaultNamespace | quote }}
AGENT_SERVICE_ACCOUNT_NAME={{ default "kubara-agent" .Values.clusterCredentialRotator.agent.serviceAccountName | quote }}
AGENT_CLUSTER_ROLE_BINDING_NAME={{ default "kubara-agent" .Values.clusterCredentialRotator.agent.clusterRoleBindingName | quote }}
AGENT_CLUSTER_ROLE_NAME={{ .Values.clusterCredentialRotator.agent.clusterRoleName | quote }}
TOKEN_DURATION={{ .Values.clusterCredentialRotator.token.duration | quote }}
REFRESH_BEFORE={{ .Values.clusterCredentialRotator.token.refreshBefore | quote }}

ISSUED_AT_ANNOTATION="kubara.io/cluster-credential-issued-at"
EXPIRES_AT_ANNOTATION="kubara.io/cluster-credential-expires-at"
MANAGED_BY_ANNOTATION="kubara.io/cluster-credential-managed-by"
MANAGED_BY_VALUE="cluster-credential-rotator"
ARGO_CLUSTER_LABEL="argocd.argoproj.io/secret-type"
ARGO_CLUSTER_LABEL_VALUE="cluster"

log() (
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
)

duration_to_seconds() (
  awk -v value="$1" '
    function fail() { exit 1 }
    BEGIN {
      rest = value
      total = 0

      if (rest == "") {
        fail()
      }

      while (rest != "") {
        if (match(rest, /^[0-9]+[smhd]/) == 0) {
          fail()
        }

        part = substr(rest, RSTART, RLENGTH)
        amount = substr(part, 1, length(part) - 1) + 0
        unit = substr(part, length(part), 1)

        if (unit == "s") {
          multiplier = 1
        } else if (unit == "m") {
          multiplier = 60
        } else if (unit == "h") {
          multiplier = 3600
        } else if (unit == "d") {
          multiplier = 86400
        } else {
          fail()
        }

        total += amount * multiplier
        rest = substr(rest, RLENGTH + 1)
      }

      print total
    }
  ' </dev/null
)

rfc3339_to_epoch() (
  value=$1

  case "$value" in
    ????-??-??T??:??:??*Z)
      ;;
    *)
      return 1
      ;;
  esac

  normalized="$(
    printf '%s' "$value" |
      sed 's/\.[0-9][0-9]*Z$/Z/; s/T/ /; s/Z$//'
  )"

  date -u -d "$normalized" +%s 2>/dev/null
)

json_escape() (
  printf '%s' "$1" | awk '
    BEGIN { ORS = "" }
    {
      if (NR > 1) {
        printf "\\n"
      }
      gsub(/\\/, "\\\\")
      gsub(/"/, "\\\"")
      gsub(/\r/, "\\r")
      gsub(/\t/, "\\t")
      printf "%s", $0
    }
  '
)

get_secret_label() (
  secret_name=$1
  label_key=$2

  open_braces="$(printf '%s%s' '{' '{')"
  close_braces="$(printf '%s%s' '}' '}')"

  template_string="${open_braces} index .metadata.labels \"${label_key}\" ${close_braces}"

  if ! value="$(
    kubectl \
      -n "$RELEASE_NAMESPACE" \
      get secret "$secret_name" \
      -o "go-template=${template_string}"
  )"; then
    return 1
  fi

  case "$value" in
    "<no value>"|"<nil>")
      return 0
      ;;
  esac

  printf '%s' "$value"
)

get_secret_annotation() (
  secret_name=$1
  annotation_key=$2

  open_braces="$(printf '%s%s' '{' '{')"
  close_braces="$(printf '%s%s' '}' '}')"

  template_string="${open_braces} index .metadata.annotations \"${annotation_key}\" ${close_braces}"

  if ! value="$(
    kubectl \
      -n "$RELEASE_NAMESPACE" \
      get secret "$secret_name" \
      -o "go-template=${template_string}"
  )"; then
    return 1
  fi

  case "$value" in
    "<no value>"|"<nil>")
      return 0
      ;;
  esac

  printf '%s' "$value"
)

validate_agent_namespace() (
  namespace=$1

  if [ -z "$namespace" ]; then
    return 1
  fi

  if [ "${#namespace}" -gt 63 ]; then
    return 1
  fi

  printf '%s' "$namespace" |
    grep -Eq '^[a-z0-9]([-a-z0-9]*[a-z0-9])?$'
)

get_secret_data() (
  kubectl \
    -n "$RELEASE_NAMESPACE" \
    get secret "$1" \
    -o "jsonpath={.data['$2']}"
)

get_secret_value() (
  encoded_value="$(get_secret_data "$1" "$2")" || return 1

  if [ -z "$encoded_value" ]; then
    return 0
  fi

  printf '%s' "$encoded_value" | base64 -d
)

get_secret_type() (
  kubectl \
    -n "$RELEASE_NAMESPACE" \
    get secret "$1" \
    -o jsonpath='{.type}'
)

# Render labels from a Kubernetes object as sorted key=value lines. The Go
# template braces are assembled at runtime so Helm's tpl() does not interpret
# the kubectl template itself.
get_resource_label_lines() (
  resource_kind=$1
  resource_name=$2
  output_file=$3

  raw_labels_file="$(mktemp)" || return 1
  trap 'rm -f "$raw_labels_file"' EXIT INT TERM

  open_braces="$(printf '%s%s' '{' '{')"
  close_braces="$(printf '%s%s' '}' '}')"
  template_string="${open_braces}range \$key, \$value := .metadata.labels${close_braces}${open_braces}printf \"%s=%s\\n\" \$key \$value${close_braces}${open_braces}end${close_braces}"

  if ! kubectl \
    -n "$RELEASE_NAMESPACE" \
    get "$resource_kind" "$resource_name" \
    -o "go-template=${template_string}" \
    >"$raw_labels_file"; then
    return 1
  fi

  sort "$raw_labels_file" >"$output_file"
)

get_label_value() (
  labels_file=$1
  expected_key=$2

  while IFS= read -r line || [ -n "$line" ]; do
    key=${line%%=*}
    if [ "$key" = "$expected_key" ]; then
      printf '%s' "${line#*=}"
      return 0
    fi
  done <"$labels_file"

  return 1
)

validate_authoritative_labels() (
  labels_file=$1
  config_map_name=$2

  if ! argo_label="$(get_label_value "$labels_file" "$ARGO_CLUSTER_LABEL")"; then
    log "configmap ${config_map_name} is missing required label ${ARGO_CLUSTER_LABEL}"
    return 1
  fi

  if [ "$argo_label" != "$ARGO_CLUSTER_LABEL_VALUE" ]; then
    log "configmap ${config_map_name} has invalid ${ARGO_CLUSTER_LABEL} label: ${argo_label}"
    return 1
  fi

  if ! rotator_label="$(get_label_value "$labels_file" "$LABEL_KEY")"; then
    log "configmap ${config_map_name} is missing required rotator label ${LABEL_KEY}"
    return 1
  fi

  if [ "$rotator_label" != "$LABEL_VALUE" ]; then
    log "configmap ${config_map_name} has invalid ${LABEL_KEY} label: ${rotator_label}"
    return 1
  fi
)

write_labels_json() (
  labels_file=$1
  output_file=$2
  first=1

  printf '{' >"$output_file" || return 1

  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue

    key=${line%%=*}
    value=${line#*=}

    escaped_key="$(json_escape "$key")" || return 1
    escaped_value="$(json_escape "$value")" || return 1

    if [ "$first" -eq 0 ]; then
      printf ',' >>"$output_file" || return 1
    fi

    printf '"%s":"%s"' "$escaped_key" "$escaped_value" >>"$output_file" || return 1
    first=0
  done <"$labels_file"

  printf '}' >>"$output_file" || return 1
)

sync_secret_labels() (
  secret_name=$1
  desired_labels_file=$2
  current_labels_file=$3
  labels_json_file=$4
  labels_patch_file=$5

  if ! get_resource_label_lines secret "$secret_name" "$current_labels_file"; then
    log "failed to read labels from secret ${secret_name}"
    return 1
  fi

  desired_labels="$(cat "$desired_labels_file")" || return 1
  current_labels="$(cat "$current_labels_file")" || return 1

  if [ "$desired_labels" = "$current_labels" ]; then
    return 0
  fi

  if ! write_labels_json "$desired_labels_file" "$labels_json_file"; then
    log "failed to encode desired labels for secret ${secret_name}"
    return 1
  fi

  labels_json="$(cat "$labels_json_file")" || return 1

  cat >"$labels_patch_file" <<EOF_LABEL_PATCH
[
  {
    "op": "add",
    "path": "/metadata/labels",
    "value": ${labels_json}
  }
]
EOF_LABEL_PATCH

  if ! kubectl \
    -n "$RELEASE_NAMESPACE" \
    patch secret "$secret_name" \
    --type json \
    --patch-file "$labels_patch_file" \
    >/dev/null; then
    log "failed to replace labels on secret ${secret_name}"
    return 1
  fi

  log "synchronized GitOps-managed labels for ${secret_name}"
)

build_generated_kubeconfig() (
  kubeconfig_path=$1
  server=$2
  ca_data=$3
  insecure=$4
  token=$5

  case "$insecure" in
    true)
      cat >"$kubeconfig_path" <<EOF_KUBECONFIG
apiVersion: v1
kind: Config
clusters:
- cluster:
    insecure-skip-tls-verify: true
    server: ${server}
  name: managed-cluster
contexts:
- context:
    cluster: managed-cluster
    user: kubara-agent
  name: managed-cluster
current-context: managed-cluster
users:
- name: kubara-agent
  user:
    token: ${token}
EOF_KUBECONFIG
      ;;
    false)
      if [ -n "$ca_data" ]; then
        cat >"$kubeconfig_path" <<EOF_KUBECONFIG
apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: ${ca_data}
    server: ${server}
  name: managed-cluster
contexts:
- context:
    cluster: managed-cluster
    user: kubara-agent
  name: managed-cluster
current-context: managed-cluster
users:
- name: kubara-agent
  user:
    token: ${token}
EOF_KUBECONFIG
      else
        cat >"$kubeconfig_path" <<EOF_KUBECONFIG
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: ${server}
  name: managed-cluster
contexts:
- context:
    cluster: managed-cluster
    user: kubara-agent
  name: managed-cluster
current-context: managed-cluster
users:
- name: kubara-agent
  user:
    token: ${token}
EOF_KUBECONFIG
      fi
      ;;
    *)
      return 1
      ;;
  esac
)

generated_config_token() (
  printf '%s' "$1" | sed -n 's/.*"bearerToken":"\([^"]*\)".*/\1/p'
)

generated_config_ca_data() (
  printf '%s' "$1" | sed -n 's/.*"caData":"\([^"]*\)".*/\1/p'
)

generated_config_insecure() (
  printf '%s' "$1" | sed -n 's/.*"insecure":\([^,}]*\).*/\1/p'
)

validate_generated_credentials() (
  validation_kubeconfig=$1
  server=$2
  ca_data=$3
  insecure=$4
  token=$5

  build_generated_kubeconfig \
    "$validation_kubeconfig" \
    "$server" \
    "$ca_data" \
    "$insecure" \
    "$token" || return 1

  kubectl \
    --kubeconfig "$validation_kubeconfig" \
    get namespace kube-system \
    >/dev/null
)

ensure_agent_identity() (
  bootstrap_kubeconfig=$1
  agent_namespace=$2

  cat <<EOF_AGENT | kubectl --kubeconfig "$bootstrap_kubeconfig" apply -f - >/dev/null
apiVersion: v1
kind: Namespace
metadata:
  name: ${agent_namespace}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${AGENT_SERVICE_ACCOUNT_NAME}
  namespace: ${agent_namespace}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${AGENT_CLUSTER_ROLE_BINDING_NAME}
subjects:
  - kind: ServiceAccount
    name: ${AGENT_SERVICE_ACCOUNT_NAME}
    namespace: ${agent_namespace}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: ${AGENT_CLUSTER_ROLE_NAME}
EOF_AGENT
)

mint_agent_token() (
  kubeconfig=$1
  agent_namespace=$2
  output_file=$3

  kubectl \
    --kubeconfig "$kubeconfig" \
    -n "$agent_namespace" \
    create token "$AGENT_SERVICE_ACCOUNT_NAME" \
    --duration="${TOKEN_DURATION_SECONDS}s" \
    -o jsonpath='{.status.token}{"\n"}{.status.expirationTimestamp}{"\n"}' \
    >"$output_file"
)

refresh_due() (
  expires_at=$1
  refresh_after_epoch=$2

  case "$expires_at" in
    ''|*[!0-9]*)
      return 0
      ;;
  esac

  [ "$refresh_after_epoch" -ge "$expires_at" ]
)

patch_secret_with_credentials() (
  secret_name=$1
  patch_file=$2
  cluster_name=$3
  server=$4
  generated_config=$5
  issued_at=$6
  expires_at=$7

  escaped_name="$(json_escape "$cluster_name")" || return 1
  escaped_server="$(json_escape "$server")" || return 1
  escaped_config="$(json_escape "$generated_config")" || return 1

  cat >"$patch_file" <<EOF_PATCH
{
  "metadata": {
    "annotations": {
      "${ISSUED_AT_ANNOTATION}": "${issued_at}",
      "${EXPIRES_AT_ANNOTATION}": "${expires_at}",
      "${MANAGED_BY_ANNOTATION}": "${MANAGED_BY_VALUE}"
    }
  },
  "stringData": {
    "name": "${escaped_name}",
    "server": "${escaped_server}",
    "${GENERATED_CONFIG_KEY}": "${escaped_config}"
  }
}
EOF_PATCH

  kubectl \
    -n "$RELEASE_NAMESPACE" \
    patch secret "$secret_name" \
    --type merge \
    --patch-file "$patch_file" \
    >/dev/null
)

reconcile_secret() (
  set -u

  secret_name=$1

  work_dir="$(mktemp -d)" || {
    log "failed to create temporary working directory for ${secret_name}"
    return 1
  }
  trap 'rm -rf "$work_dir"' EXIT INT TERM

  bootstrap_kubeconfig_file="${work_dir}/bootstrap.kubeconfig"
  current_kubeconfig_file="${work_dir}/current.kubeconfig"
  candidate_kubeconfig_file="${work_dir}/candidate.kubeconfig"
  token_request_file="${work_dir}/token-request"
  credential_patch_file="${work_dir}/credential-patch.json"
  desired_labels_file="${work_dir}/desired-labels"
  current_labels_file="${work_dir}/current-labels"
  labels_json_file="${work_dir}/labels.json"
  labels_patch_file="${work_dir}/labels-patch.json"

  if ! secret_type="$(get_secret_type "$secret_name")"; then
    log "failed to read type for secret ${secret_name}"
    return 1
  fi

  if [ -n "$REQUIRED_TYPE" ] && [ "$secret_type" != "$REQUIRED_TYPE" ]; then
    if [ -n "$TARGET_SECRET_NAME" ]; then
      log "target secret ${secret_name}: expected secret type ${REQUIRED_TYPE}, found ${secret_type:-<empty>}"
      return 1
    fi

    log "skipping ${secret_name}: expected secret type ${REQUIRED_TYPE}, found ${secret_type:-<empty>}"
    return 0
  fi

  if ! cluster_name="$(get_secret_value "$secret_name" "name")"; then
    log "failed to read cluster name from secret ${secret_name}"
    return 1
  fi

  if [ -z "$cluster_name" ]; then
    case "$secret_name" in
      *-cluster-secret)
        cluster_name=${secret_name%-cluster-secret}
        ;;
      *)
        cluster_name=$secret_name
        ;;
    esac
  fi

  config_map_name="${cluster_name}${CONFIG_MAP_SUFFIX}"

  if ! get_resource_label_lines configmap "$config_map_name" "$desired_labels_file"; then
    log "failed to read authoritative labels from configmap ${config_map_name}"
    return 1
  fi

  if ! validate_authoritative_labels "$desired_labels_file" "$config_map_name"; then
    return 1
  fi

  if ! agent_namespace="$(get_secret_annotation "$secret_name" "$AGENT_NAMESPACE_ANNOTATION")"; then
    log "failed to read agent namespace annotation from secret ${secret_name}"
    return 1
  fi

  if [ -z "$agent_namespace" ]; then
    agent_namespace="$DEFAULT_AGENT_NAMESPACE"
  fi

  if ! validate_agent_namespace "$agent_namespace"; then
    log "invalid kubara-agent namespace ${agent_namespace} for ${cluster_name}"
    return 1
  fi

  if ! current_config="$(get_secret_value "$secret_name" "$GENERATED_CONFIG_KEY")"; then
    log "failed to read generated config from secret ${secret_name}"
    return 1
  fi

  if ! current_epoch="$(date +%s)"; then
    log "failed to determine current time while reconciling ${secret_name}"
    return 1
  fi

  case "$current_epoch" in
    ''|*[!0-9]*)
      log "current time is not a valid epoch value while reconciling ${secret_name}"
      return 1
      ;;
  esac

  refresh_after_epoch=$((current_epoch + REFRESH_BEFORE_SECONDS))

  if [ -z "$current_config" ]; then
    # FIRST ONBOARDING: bootstrap is used only to establish kubara-agent and
    # mint the first rotating credential.
    log "no generated credentials found for ${cluster_name}; using bootstrap credentials for initial onboarding"

    if ! bootstrap_kubeconfig="$(get_secret_value "$secret_name" "$BOOTSTRAP_KUBECONFIG_KEY")"; then
      log "failed to read bootstrap kubeconfig from secret ${secret_name}"
      return 1
    fi

    if [ -z "$bootstrap_kubeconfig" ]; then
      log "secret ${secret_name} is missing required bootstrap key ${BOOTSTRAP_KUBECONFIG_KEY}"
      return 1
    fi

    printf '%s' "$bootstrap_kubeconfig" >"$bootstrap_kubeconfig_file" || return 1

    if ! server="$(
      kubectl \
        --kubeconfig "$bootstrap_kubeconfig_file" \
        config view \
        --raw \
        --flatten \
        --minify \
        -o jsonpath='{.clusters[0].cluster.server}'
    )"; then
      log "failed to read cluster server from bootstrap kubeconfig for ${cluster_name}"
      return 1
    fi

    if [ -z "$server" ]; then
      log "bootstrap kubeconfig for ${cluster_name} did not yield a cluster server endpoint"
      return 1
    fi

    if ! ca_data="$(
      kubectl \
        --kubeconfig "$bootstrap_kubeconfig_file" \
        config view \
        --raw \
        --flatten \
        --minify \
        -o jsonpath='{.clusters[0].cluster.certificate-authority-data}'
    )"; then
      log "failed to read cluster CA data from bootstrap kubeconfig for ${cluster_name}"
      return 1
    fi

    if ! insecure="$(
      kubectl \
        --kubeconfig "$bootstrap_kubeconfig_file" \
        config view \
        --raw \
        --flatten \
        --minify \
        -o jsonpath='{.clusters[0].cluster.insecure-skip-tls-verify}'
    )"; then
      log "failed to read TLS settings from bootstrap kubeconfig for ${cluster_name}"
      return 1
    fi

    [ -n "$insecure" ] || insecure="false"

    case "$insecure" in
      true|false)
        ;;
      *)
        log "bootstrap kubeconfig for ${cluster_name} contains an invalid insecure-skip-tls-verify value"
        return 1
        ;;
    esac

    log "provisioning kubara-agent in namespace ${agent_namespace} for ${cluster_name}"

    if ! ensure_agent_identity "$bootstrap_kubeconfig_file" "$agent_namespace"; then
      log "failed to provision kubara-agent for ${cluster_name}"
      return 1
    fi

    if ! mint_agent_token "$bootstrap_kubeconfig_file" "$agent_namespace" "$token_request_file"; then
      log "failed to mint initial kubara-agent token for ${cluster_name}"
      return 1
    fi
  else
    # NORMAL ROTATION: bootstrap credentials are intentionally never used.
    # GitOps label changes are synchronized on every run, independently of
    # whether a credential refresh is required.
    if ! sync_secret_labels \
      "$secret_name" \
      "$desired_labels_file" \
      "$current_labels_file" \
      "$labels_json_file" \
      "$labels_patch_file"; then
      return 1
    fi

    if ! server="$(get_secret_value "$secret_name" "server")"; then
      log "failed to read cluster server from secret ${secret_name}"
      return 1
    fi

    if [ -z "$server" ]; then
      log "generated credentials exist for ${cluster_name}, but the server field is missing"
      return 1
    fi

    current_token="$(generated_config_token "$current_config")"
    ca_data="$(generated_config_ca_data "$current_config")"
    insecure="$(generated_config_insecure "$current_config")"

    if [ -z "$current_token" ]; then
      log "generated credentials for ${cluster_name} do not contain a bearer token"
      return 1
    fi

    case "$insecure" in
      true|false)
        ;;
      *)
        log "generated credentials for ${cluster_name} contain an invalid TLS insecure flag"
        return 1
        ;;
    esac

    if ! build_generated_kubeconfig \
      "$current_kubeconfig_file" \
      "$server" \
      "$ca_data" \
      "$insecure" \
      "$current_token"; then
      log "failed to build current generated kubeconfig for ${cluster_name}"
      return 1
    fi

    if ! kubectl \
      --kubeconfig "$current_kubeconfig_file" \
      get namespace kube-system \
      >/dev/null; then
      log "current generated credentials for ${cluster_name} are invalid; automatic rotation cannot continue without explicit re-onboarding"
      return 1
    fi

    if ! expires_at="$(get_secret_annotation "$secret_name" "$EXPIRES_AT_ANNOTATION")"; then
      log "failed to read expiry annotation from secret ${secret_name}"
      return 1
    fi

    if ! refresh_due "$expires_at" "$refresh_after_epoch"; then
      log "secret ${cluster_name} already has valid generated credentials"
      return 0
    fi

    log "rotating credentials for ${cluster_name} using current kubara-agent credentials"

    if ! mint_agent_token "$current_kubeconfig_file" "$agent_namespace" "$token_request_file"; then
      log "failed to mint replacement kubara-agent token for ${cluster_name}"
      return 1
    fi
  fi

  token="$(sed -n '1p' "$token_request_file")"
  expiration_timestamp="$(sed -n '2p' "$token_request_file")"

  if [ -z "$token" ]; then
    log "token request returned an empty token for ${cluster_name}"
    return 1
  fi

  if [ -z "$expiration_timestamp" ]; then
    log "token request returned no expiration timestamp for ${cluster_name}"
    return 1
  fi

  if ! expires_at="$(rfc3339_to_epoch "$expiration_timestamp")"; then
    log "failed to parse token expiration timestamp for ${cluster_name}: ${expiration_timestamp}"
    return 1
  fi

  issued_at="$(date +%s)" || return 1

  case "$issued_at" in
    ''|*[!0-9]*)
      log "token issue time is not a valid epoch value for ${cluster_name}"
      return 1
      ;;
  esac

  if [ "$expires_at" -le "$issued_at" ]; then
    log "token request returned an already-expired credential for ${cluster_name}"
    return 1
  fi

  actual_lifetime=$((expires_at - issued_at))
  if [ "$actual_lifetime" -le "$REFRESH_BEFORE_SECONDS" ]; then
    log "token lifetime returned by the API server for ${cluster_name} (${actual_lifetime}s) is not greater than refreshBefore (${REFRESH_BEFORE_SECONDS}s)"
    return 1
  fi

  generated_config="$(
    printf \
      '{"bearerToken":"%s","tlsClientConfig":{"caData":"%s","insecure":%s}}' \
      "$token" \
      "$ca_data" \
      "$insecure"
  )"

  if ! validate_generated_credentials \
    "$candidate_kubeconfig_file" \
    "$server" \
    "$ca_data" \
    "$insecure" \
    "$token"; then
    log "generated credentials for ${cluster_name} failed validation"
    return 1
  fi

  # Credentials are persisted before the ConfigMap labels are promoted to the
  # Argo CD cluster Secret. This avoids exposing an incomplete initial Secret
  # to Argo CD if credential generation fails.
  if ! patch_secret_with_credentials \
    "$secret_name" \
    "$credential_patch_file" \
    "$cluster_name" \
    "$server" \
    "$generated_config" \
    "$issued_at" \
    "$expires_at"; then
    log "failed to update generated credentials in secret ${secret_name}"
    return 1
  fi

  if [ -z "$current_config" ]; then
    if ! sync_secret_labels \
      "$secret_name" \
      "$desired_labels_file" \
      "$current_labels_file" \
      "$labels_json_file" \
      "$labels_patch_file"; then
      return 1
    fi
  fi

  log "successfully refreshed credentials for ${cluster_name}"
)

if ! TOKEN_DURATION_SECONDS="$(duration_to_seconds "$TOKEN_DURATION")"; then
  log "invalid token duration: ${TOKEN_DURATION}"
  exit 1
fi

if ! REFRESH_BEFORE_SECONDS="$(duration_to_seconds "$REFRESH_BEFORE")"; then
  log "invalid refresh-before duration: ${REFRESH_BEFORE}"
  exit 1
fi

if [ "$TOKEN_DURATION_SECONDS" -le 0 ]; then
  log "token duration must be greater than zero"
  exit 1
fi

if [ "$REFRESH_BEFORE_SECONDS" -lt 0 ]; then
  log "refreshBefore must not be negative"
  exit 1
fi

if [ "$REFRESH_BEFORE_SECONDS" -ge "$TOKEN_DURATION_SECONDS" ]; then
  log "refreshBefore (${REFRESH_BEFORE}) must be smaller than token duration (${TOKEN_DURATION})"
  exit 1
fi

if [ -n "$TARGET_SECRET_NAME" ]; then
  if ! target_label="$(
    get_secret_label "$TARGET_SECRET_NAME" "$LABEL_KEY"
  )"; then
    log "failed to read target secret ${TARGET_SECRET_NAME}"
    exit 1
  fi

  if [ "$target_label" != "$LABEL_VALUE" ]; then
    log "target secret ${TARGET_SECRET_NAME} is not managed by the credential rotator"
    exit 1
  fi

  managed_secrets="$TARGET_SECRET_NAME"
else
  if ! managed_secrets="$(
    kubectl \
      -n "$RELEASE_NAMESPACE" \
      get secrets \
      -l "${LABEL_KEY}=${LABEL_VALUE}" \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
  )"; then
    log "failed to list rotator-managed secrets in namespace ${RELEASE_NAMESPACE}"
    exit 1
  fi
fi

if [ -z "$managed_secrets" ]; then
  log "no rotator-managed cluster secrets found in namespace ${RELEASE_NAMESPACE}"
  exit 0
fi

failure_count=0

for secret_name in $managed_secrets; do
  if ! reconcile_secret "$secret_name"; then
    failure_count=$((failure_count + 1))
  fi
done

if [ "$failure_count" -gt 0 ]; then
  log "${failure_count} secret reconciliation(s) failed"
  exit 1
fi

log "cluster credential rotation completed successfully"
