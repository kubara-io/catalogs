{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["customManagers:githubActionsVersions"],
  "addLabels": ["dependencies"],
  "terraform": {
    "fileMatch": ["\\.tf(\\.tplt)?$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker image tags in Helm values templates",
      "managerFilePatterns": ["/values\\.ya?ml\\.tplt$/"],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["bootstrap/**"],
      "addLabels": ["bootstrap"]
    },
    {
      "matchFileNames": ["general/**"],
      "addLabels": ["general"]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["patch"]
    }
    {
      "matchFiles": ["**/Chart.{yaml,yml}"],
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.{yaml,yml}"],
          "matchStrings": ["version:\\s(?<version>[^\\s]+)"],
          "bumpType": "{{#if isMajor}}major{{else if isMinor}}minor{{else}}patch{{/if}}"
        }
      ],
      "postUpgradeTasks": {
        "commands": [
          "./.scripts/renovate_bot_update_helm_changelog.sh \"{{{depName}}}\" \"{{{currentVersion}}}\" \"{{{newVersion}}}\" \"{{{packageFileDir}}}\" \"{{#if isMajor}}major{{/if}}{{#if isMinor}}minor{{/if}}{{#if isPatch}}patch{{/if}}\""
        ],
        "fileFilters": ["**/CHANGELOG.md"],
        "executionMode": "update"
      }
    }
  ]
}
