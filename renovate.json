{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["customManagers:githubActionsVersions"],
  "addLabels": ["dependencies"],
  "automerge": true,
  "platformAutomerge": true,
  "terraform": {
    "fileMatch": ["\\.tf(\\.tplt)?$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker image tags in Helm component values and generated config templates",
      "managerFilePatterns": [
        "/(bootstrap|general)/platform-components/helm/[^/]+/values\\.ya?ml$/",
        "/(bootstrap|general)/platform-configs/helm/[^/]+/values\\.generated\\.ya?ml\\.tplt$/"
      ],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
        "tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\s*\\n\\s*repository:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "bootstrap/**/Chart.yaml",
        "bootstrap/platform-components/**/values.yaml"
      ],
      "groupName": "bootstrap helm charts",
      "groupSlug": "bootstrap-helm-charts",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": ["./.scripts/renovate_bot_update_versions.sh"],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": [
          "**/Chart.yaml",
          "**/CHANGELOG.md",
          "bootstrap/Catalog.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": [
        "general/**/Chart.yaml",
        "general/platform-components/**/values.yaml"
      ],
      "groupName": "general helm charts",
      "groupSlug": "general-helm-charts",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": ["./.scripts/renovate_bot_update_versions.sh"],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": [
          "**/Chart.yaml",
          "**/CHANGELOG.md",
          "general/Catalog.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["terraform"],
      "matchFileNames": ["bootstrap/**/*.tf", "bootstrap/**/*.tf.tplt"],
      "groupName": "bootstrap terraform",
      "groupSlug": "bootstrap-terraform",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": ["./.scripts/renovate_bot_update_versions.sh"],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": ["bootstrap/Catalog.yaml"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["terraform"],
      "matchFileNames": ["general/**/*.tf", "general/**/*.tf.tplt"],
      "groupName": "general terraform",
      "groupSlug": "general-terraform",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": ["./.scripts/renovate_bot_update_versions.sh"],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": ["general/Catalog.yaml"],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["bootstrap/platform-configs/**/values.generated.yaml.tplt"],
      "groupName": "bootstrap helm charts",
      "groupSlug": "bootstrap-helm-charts",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": ["./.scripts/renovate_bot_update_versions.sh"],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": [
          "**/Chart.yaml",
          "**/CHANGELOG.md",
          "bootstrap/Catalog.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["general/platform-configs/**/values.generated.yaml.tplt"],
      "groupName": "general helm charts",
      "groupSlug": "general-helm-charts",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": ["./.scripts/renovate_bot_update_versions.sh"],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": [
          "**/Chart.yaml",
          "**/CHANGELOG.md",
          "general/Catalog.yaml"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
