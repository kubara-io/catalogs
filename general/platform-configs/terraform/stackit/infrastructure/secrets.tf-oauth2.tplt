{{- $ephemeral := index .cluster.terraform "ephemeralSecrets" -}}
# Optional OAuth2/registry secrets. Copy to oauth2-secrets.tf to enable.
{{ if $ephemeral }}# Keep enabled after apply: Vault entries stay managed, their payloads do not
# enter state or saved plans. Uses the root's default Vault provider.
{{ end }}
variable "image_pull_secret" {
  type      = string
  sensitive = true
{{ if $ephemeral }}  ephemeral = true
{{ end }}}
variable "oauth2_client_secret" {
  type        = string
  description = "Client Secret for connecting the \"landing page\" Oauth2 App and configuring Oauth2 Proxy"
  sensitive   = true
{{ if $ephemeral }}  ephemeral   = true
{{ end }}}
variable "oauth2_client_id" {
  type        = string
  description = "Client ID for connecting the \"landing page\" Oauth2 App and configuring Oauth2 Proxy"
}
variable "argo_oauth2_client_secret" {
  type        = string
  description = "Client Secret for connecting the ArgoCD Oauth2 App"
  sensitive   = true
{{ if $ephemeral }}  ephemeral   = true
{{ end }}}
variable "argo_oauth2_client_id" {
  type        = string
  description = "Client ID for connecting the ArgoCD Oauth2 App"
}
variable "grafana_oauth2_client_secret" {
  type        = string
  description = "Client Secret for connecting the Grafana Oauth2 App"
  sensitive   = true
{{ if $ephemeral }}  ephemeral   = true
{{ end }}}
variable "grafana_oauth2_client_id" {
  type        = string
  description = "Client ID for connecting the Grafana Oauth2 App"
}

{{ if $ephemeral }}# These counters are configuration revisions, not Vault KV version numbers.
# Increment only the entry whose payload should be written again, including
# when changing a client ID. Changing a secret input alone does not update Vault.
# Set revisions in a hand-maintained secret-versions.auto.tfvars file.
# Do not edit generated defaults: kubara generate replaces them.
variable "oauth2_secret_versions" {
  description = "Positive integer revision for each write-only Vault payload."
  type = object({
    image_pull_secret    = number
    oauth2_creds         = number
    argo_oauth2_creds    = number
    grafana_oauth2_creds = number
  })
  default = {
    image_pull_secret    = 1
    oauth2_creds         = 1
    argo_oauth2_creds    = 1
    grafana_oauth2_creds = 1
  }
  validation {
    condition     = alltrue([for version in values(var.oauth2_secret_versions) : version >= 1 && version == floor(version)])
    error_message = "Each secret version must be a positive integer."
  }
}
{{ end }}
# Secrets for image pull secret
resource "vault_kv_secret_v2" "image_pull_secret" {
  mount = module.secretsmanager.instance_id
  name  = "${var.name}/${var.stage}/cluster_secrets/docker_config"
  data_json{{ if $ephemeral }}_wo{{ end }} = jsonencode({
    pull-secret = base64decode(var.image_pull_secret)
  })
{{ if $ephemeral }}  data_json_wo_version = var.oauth2_secret_versions.image_pull_secret
{{ end }}}

# Valid 32 Byte Base64 URL encoding set that will decode to 24 []byte AES-192 secret
{{ if $ephemeral }}ephemeral{{ else }}resource{{ end }} "random_password" "oauth2_cookie_secret" {
  length           = 32
  override_special = "-_"
}

# Secrets for connecting the "landing page" Oauth2 App and configuring Oauth2 Proxy
resource "vault_kv_secret_v2" "oauth2_creds" {
  mount = module.secretsmanager.instance_id
  name  = "${var.name}/${var.stage}/oauth2-proxy/oauth2_credentials"
  data_json{{ if $ephemeral }}_wo{{ end }} = jsonencode({
    cookie-secret = {{ if $ephemeral }}ephemeral.{{ end }}random_password.oauth2_cookie_secret.result
    client-secret = var.oauth2_client_secret
    client-id     = var.oauth2_client_id
  })
{{ if $ephemeral }}  data_json_wo_version = var.oauth2_secret_versions.oauth2_creds
{{ end }}}

# Secrets for connecting ArgoCD Oauth2 App
resource "vault_kv_secret_v2" "argo_oauth2_creds" {
  mount = module.secretsmanager.instance_id
  name  = "${var.name}/${var.stage}/argocd/argo_oauth2_credentials"
  data_json{{ if $ephemeral }}_wo{{ end }} = jsonencode({
    client-secret = var.argo_oauth2_client_secret
    client-id     = var.argo_oauth2_client_id
  })
{{ if $ephemeral }}  data_json_wo_version = var.oauth2_secret_versions.argo_oauth2_creds
{{ end }}}

# Secrets for connecting Grafana Oauth2 App
resource "vault_kv_secret_v2" "grafana_oauth2_creds" {
  mount = module.secretsmanager.instance_id
  name  = "${var.name}/${var.stage}/kube-prometheus-stack/grafana_oauth2_credentials"
  data_json{{ if $ephemeral }}_wo{{ end }} = jsonencode({
    client-secret = var.grafana_oauth2_client_secret
    client-id     = var.grafana_oauth2_client_id
  })
{{ if $ephemeral }}  data_json_wo_version = var.oauth2_secret_versions.grafana_oauth2_creds
{{ end }}}
