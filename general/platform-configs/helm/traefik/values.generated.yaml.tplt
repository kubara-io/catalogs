# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually in any way.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $oauth2ProxyEnabled := eq (index .cluster.services "oauth2-proxy" "status") "enabled" }}
{{- $tCloudPublicCCE := and .cluster.terraform (eq .cluster.terraform.provider "t-cloud-public") (eq .cluster.terraform.kubernetesType "cce") }}
traefik:
  ports:
    web:
      allowACMEByPass: true
      http:
        redirections:
          entryPoint:
            to: websecure
            scheme: https
            permanent: true
    websecure:
      http:
        middlewares:
          - traefik-hsts-headers@kubernetescrd
  deployment:
    imagePullSecrets:
      - name: image-pull-secret
  api:
    dashboard: true
    {{- if $oauth2ProxyEnabled }}
    basePath: /traefik
    {{- end }}
  ingressRoute:
    dashboard:
      {{- if $oauth2ProxyEnabled }}
      enabled: true
      entryPoints:
        - websecure
      matchRule: Host(`{{ .cluster.dnsName }}`) && PathPrefix(`/traefik`)
      middlewares:
        - name: oauth-auth
          namespace: traefik
      tls: {}
      {{- else }}
      enabled: false
      {{- end }}
  extraObjects:
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: hsts-headers
        namespace: traefik
      spec:
        headers:
          stsSeconds: 31536000
          forceSTSHeader: true
    {{- if $oauth2ProxyEnabled }}
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: oauth-auth
        namespace: traefik
      spec:
        forwardAuth:
          address: http://oauth2-proxy.oauth2-proxy.svc.cluster.local/oauth2/
          trustForwardHeader: true
          authResponseHeaders:
            - X-Auth-Request-User
            - X-Auth-Request-Email
            - Authorization
    {{- end }}
    {{- if $tCloudPublicCCE }}
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: openbao-redirect-noslash
        namespace: openbao
      spec:
        redirectRegex:
          permanent: true
          regex: "^(https?://[^/]+/openbao)$"
          replacement: "${1}/"
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: openbao-strip-prefix
        namespace: openbao
      spec:
        replacePathRegex:
          regex: "^/openbao/(.*)"
          replacement: "/${1}"
    {{- end }}
  {{- if $tCloudPublicCCE }}
  service:
    annotations:
      kubernetes.io/elb.id: "CHANGE_ME_TERRAFORM_OUTPUT_LOAD_BALANCER_ID"
      kubernetes.io/elb.class: "union"
  {{- end }}
  metrics:
    prometheus:
      serviceMonitor:
        {{- if (eq (index .cluster.services "kube-prometheus-stack" "status") "enabled") }}
        enabled: true
        {{- end }}
        additionalLabels:
          monitoring.instance: "{{ .cluster.name }}-{{ .cluster.stage }}"

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"
