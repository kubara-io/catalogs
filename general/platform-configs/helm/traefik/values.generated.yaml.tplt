# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually in any way.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $networkingType := dig "cluster" "networking" "type" "ingress" . }}
{{- $gateway := dig "cluster" "networking" "gateway" (dict) . }}
{{- if ne $networkingType "gateway" }}
{{- $gateway = dict }}
{{- end }}
{{- $oauth2ProxyEnabled := eq (index .cluster.services "oauth2-proxy" "status") "enabled" }}
{{- $tCloudPublicCCE := and .cluster.terraform (eq .cluster.terraform.provider "t-cloud-public") (eq .cluster.terraform.kubernetesType "cce") }}
{{- if and $gateway (ne $gateway.namespace "traefik") }}
{{- fail "the bundled Traefik Gateway must use namespace traefik" }}
{{- end }}
{{- if and $gateway (eq (get $gateway "sectionName") "web") }}
{{- fail "networking.gateway.sectionName must identify the HTTPS listener, not web" }}
{{- end }}
traefik:
  {{- if $gateway }}
  providers:
    kubernetesGateway:
      enabled: true
    kubernetesCRD:
      enabled: true
  gateway:
    enabled: true
    name: {{ $gateway.name | quote }}
    namespace: {{ $gateway.namespace | quote }}
    listeners:
      web: null
      {{ get $gateway "sectionName" | default "websecure" }}:
        port: 8443
        protocol: HTTPS
        hostname: {{ .cluster.dnsName | quote }}
        namespacePolicy:
          from: Selector
          selector:
            matchLabels:
              project-name: {{ .cluster.name | quote }}
              stage: {{ .cluster.stage | quote }}
        certificateRefs:
          - name: platform-gateway-tls
  tlsStore:
    default:
      defaultCertificate:
        secretName: platform-gateway-tls
  {{- end }}
  deployment:
    imagePullSecrets:
      - name: image-pull-secret
  api:
    dashboard: true
    {{- if $oauth2ProxyEnabled }}
    basePath: /traefik
    {{- end }}
  ingressRoute:
    dashboard:
      {{- if $oauth2ProxyEnabled }}
      enabled: true
      entryPoints:
        - websecure
      matchRule: Host(`{{ .cluster.dnsName }}`) && PathPrefix(`/traefik`)
      middlewares:
        - name: oauth-auth
          namespace: traefik
      tls: {}
      {{- else }}
      enabled: false
      {{- end }}
  {{- if or $oauth2ProxyEnabled $tCloudPublicCCE }}
  extraObjects:
    {{- if $oauth2ProxyEnabled }}
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: oauth-auth
        namespace: traefik
      spec:
        forwardAuth:
          address: http://oauth2-proxy.oauth2-proxy.svc.cluster.local/oauth2/
          trustForwardHeader: true
          authResponseHeaders:
            - X-Auth-Request-User
            - X-Auth-Request-Email
            - Authorization
    {{- end }}
    {{- if $tCloudPublicCCE }}
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: openbao-redirect-noslash
        namespace: openbao
      spec:
        redirectRegex:
          permanent: true
          regex: "^(https?://[^/]+/openbao)$"
          replacement: "${1}/"
    - apiVersion: traefik.io/v1alpha1
      kind: Middleware
      metadata:
        name: openbao-strip-prefix
        namespace: openbao
      spec:
        replacePathRegex:
          regex: "^/openbao/(.*)"
          replacement: "/${1}"
    {{- end }}
  {{- end }}
  {{- if $tCloudPublicCCE }}
  service:
    annotations:
      kubernetes.io/elb.id: "CHANGE_ME_TERRAFORM_OUTPUT_LOAD_BALANCER_ID"
      kubernetes.io/elb.class: "union"
  {{- end }}
  metrics:
    prometheus:
      serviceMonitor:
        {{- if (eq (index .cluster.services "kube-prometheus-stack" "status") "enabled") }}
        enabled: true
        {{- end }}
        additionalLabels:
          monitoring.instance: "{{ .cluster.name }}-{{ .cluster.stage }}"

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"

{{- if and $gateway
  (eq (dig "cluster" "services" "cert-manager" "status" "disabled" .) "enabled")
}}
gatewayCertificate:
  hostname: {{ .cluster.dnsName | quote }}
  issuer: {{ dig
    "cluster" "services" "cert-manager" "config" "clusterIssuer" "name"
    "letsencrypt-staging"
    . | quote
  }}
{{- end }}

{{- if and $gateway $oauth2ProxyEnabled (eq .cluster.type "hub") }}
argocdGatewayAuth: true
{{- end }}
