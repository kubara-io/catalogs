# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually in any way.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $ingressClass := dig
  "cluster" "networking" "ingress" "className"
  (.cluster.ingressClassName | default "traefik")
  .
}}
{{- $clusterGateway := dig "cluster" "networking" "gateway" (dict) . }}
{{- $gateway := dig
  "cluster" "services" "radar" "networking" "gateway"
  $clusterGateway
  .
}}
{{- $networkingType := dig "cluster" "networking" "type" "ingress" . }}
{{- if ne $networkingType "gateway" }}
{{- $gateway = dict }}
{{- end }}
{{- $oauth2ProxyStatus := dig "cluster" "services" "oauth2-proxy" "status" "disabled" . }}
{{- $traefikStatus := dig "cluster" "services" "traefik" "status" "disabled" . }}
{{- $kubePrometheusStatus := dig "cluster" "services" "kube-prometheus-stack" "status" "disabled" . }}
{{- $sso := and (eq $oauth2ProxyStatus "enabled") (eq $traefikStatus "enabled") }}
{{- $radarIngressAnnotations := dict "cert-manager.io/cluster-issuer" (dig "cluster" "services" "cert-manager" "config" "clusterIssuer" "name" "letsencrypt-staging" .) }}
{{- if $sso }}
{{- $_ := set $radarIngressAnnotations "traefik.ingress.kubernetes.io/router.middlewares" "oauth2-proxy-oauth-auth@kubernetescrd" }}
{{- end }}
{{- $radarIngressAnnotations = mergeOverwrite $radarIngressAnnotations (dig "cluster" "services" "radar" "networking" "annotations" (dict) .) }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"
radar:
  imagePullSecrets:
    - name: image-pull-secret
  # Radar serves its UI and API under /radar itself, so no strip-prefix
  # middleware is needed in front of it.
  basePath: /radar
  # Radar refuses requests for hostnames it was not told about; the chart only
  # adds ingress hosts on its own, not the Gateway route below.
  allowedHosts:
    - {{ .cluster.dnsName }}
  {{- if (eq $kubePrometheusStatus "enabled") }}
  traffic:
    # kube-prometheus-stack serves Prometheus under its /prometheus route prefix.
    prometheusUrl: http://kube-prometheus-stack-prometheus.kube-prometheus-stack.svc:9090/prometheus
  {{- end }}
  ingress:
    {{- if $gateway }}
    enabled: false
    {{- else }}
    # Radar runs without its own login, so it is only exposed behind oauth2-proxy.
    enabled: {{ $sso }}
    {{- end }}
{{- with $ingressClass }}
    className: {{ . }}
{{- end }}
    annotations:
      {{- toYaml $radarIngressAnnotations | nindent 6 }}
    hosts:
      - host: {{ .cluster.dnsName }}
        paths:
          - path: /radar
            pathType: Prefix
    tls:
      - secretName: tls-radar
        hosts:
          - {{ .cluster.dnsName }}

{{- if $gateway }}
gatewayRoutes:
  enabled: {{ $sso }}
  auth: {{ $sso }}
  parentRef:
    {{- toYaml $gateway | nindent 4 }}
  hostname: {{ .cluster.dnsName | quote }}
  annotations:
    {{- toYaml (dig
      "cluster" "services" "radar" "networking" "annotations"
      (dict)
      .
    ) | nindent 4 }}
  routes:
    - name: ui
      path: /radar
      service: '{{ "{{ include \"radar.fullname\" (index .Subcharts \"radar\") }}" }}'
      port: 9280
{{- end }}
