# AUTO-GENERATED; DO NOT MODIFY;
# This file is auto-generated by kubara and should not be modified manually in any way.
# To customize values, you can add additional files named values-*.yaml to this directory.

{{- $ingressClass := dig
  "cluster" "networking" "ingress" "className"
  (.cluster.ingressClassName | default "traefik")
  .
}}
{{- $clusterGateway := dig "cluster" "networking" "gateway" (dict) . }}
{{- $gateway := dig
  "cluster" "services" "longhorn" "networking" "gateway"
  $clusterGateway
  .
}}
{{- $networkingType := dig "cluster" "networking" "type" "ingress" . }}
{{- if ne $networkingType "gateway" }}
{{- $gateway = dict }}
{{- end }}
{{- $oauth2ProxyStatus := dig "cluster" "services" "oauth2-proxy" "status" "disabled" . }}
{{- $traefikStatus := dig "cluster" "services" "traefik" "status" "disabled" . }}
{{- $longhornIngressAnnotations := dict "cert-manager.io/cluster-issuer" (dig "cluster" "services" "cert-manager" "config" "clusterIssuer" "name" "letsencrypt-staging" .) }}
{{- if (and (eq $oauth2ProxyStatus "enabled") (eq $traefikStatus "enabled")) }}
{{- $_ := set $longhornIngressAnnotations "traefik.ingress.kubernetes.io/router.middlewares" "longhorn-redirect-noslash@kubernetescrd,oauth2-proxy-oauth-auth@kubernetescrd,longhorn-strip-prefix@kubernetescrd" }}
{{- else if (eq $traefikStatus "enabled") }}
{{- $_ := set $longhornIngressAnnotations "traefik.ingress.kubernetes.io/router.middlewares" "longhorn-redirect-noslash@kubernetescrd,longhorn-strip-prefix@kubernetescrd" }}
{{- end }}
{{- $longhornIngressAnnotations = mergeOverwrite $longhornIngressAnnotations (dig "cluster" "services" "longhorn" "networking" "annotations" (dict) .) }}

longhorn:
  privateRegistry:
    registrySecret: image-pull-secret
  metrics:
    serviceMonitor:
      {{- if (eq (index .cluster.services "kube-prometheus-stack" "status") "enabled") }}
      enabled: true
      {{- end }}
      additionalLabels:
        monitoring.instance: "{{ .cluster.name }}-{{ .cluster.stage }}"
  defaultSettings:
    defaultReplicaCount: "1"
  persistence:
    defaultClass: true
    defaultClassReplicaCount: 1
  ingress:
    {{- if $gateway }}
    enabled: false
    {{- else if (eq $oauth2ProxyStatus "enabled") }}
    enabled: true
    {{- end }}
{{- with $ingressClass }}
    ingressClassName: {{ . }}
{{- end }}
    host: {{ .cluster.dnsName }}
    tls: true
    tlsSecret: tls-longhorn
    path: /longhorn
    pathType: Prefix
    annotations:
      {{- toYaml $longhornIngressAnnotations | nindent 6 }}

{{- if (eq $traefikStatus "enabled") }}
traefikPathRewrite:
  enabled: true
  pathPrefix: /longhorn
{{- end }}

namespace:
  labels:
    project-name: "{{ .cluster.name }}"
    stage: "{{ .cluster.stage }}"
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/audit: privileged
    pod-security.kubernetes.io/warn: privileged

{{- if $gateway }}
gatewayRoutes:
  enabled: {{ eq $oauth2ProxyStatus "enabled" }}
  auth: {{ and (eq $oauth2ProxyStatus "enabled") (eq $traefikStatus "enabled") }}
  parentRef:
    {{- toYaml $gateway | nindent 4 }}
  hostname: {{ .cluster.dnsName | quote }}
  annotations:
    {{- toYaml (dig
      "cluster" "services" "longhorn" "networking" "annotations"
      (dict)
      .
    ) | nindent 4 }}
  routes:
    - name: ui
      path: /longhorn
      service: 'longhorn-frontend'
      port: 80
      {{- if (eq $traefikStatus "enabled") }}
      middlewares: [redirect-noslash, strip-prefix]
      {{- end }}
{{- end }}
